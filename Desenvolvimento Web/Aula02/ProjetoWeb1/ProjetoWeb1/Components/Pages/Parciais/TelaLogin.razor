<main class="corpo-pagina">
    <!--Corpo da pagina-->
    <div class="login-container">
        <!--Conteiner-->
        <div class="login-cabecalho">
            <!--Cabeçalho-->
            <h1 class="login-titulo">Acesso ao WIFI</h1><!--Titulo Login-->
            <p class="login-subtitulo">Sistema de gestão de WIFI</p>
        </div>
        <form class="login-form">
            <!--Aviso: Implantar validação de campos -->
            <div class="form-grupo">
                <label class="form-label">E-mail institucional</label>
                <div class="input-w">
                    <input type="email" id="email" class="form-input" placeholder="user@3m.sp.br" />
                </div>
            </div>
            <div class="form-gupo">
                <label>Senha</label>
                <div class="input-w">
                    <input type="password" id="senha" class="form-input" placeholder="*****" />
                </div>
            </div>
            <button type="button" id="btn-entrar" class="btn-login">
                LOGIN

            </button>
        </form>
    </div>
</main>
